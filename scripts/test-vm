#!/usr/bin/env bash
# This test configures SSH, UFW, and systemd on a disposable hosted runner.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ "${GITHUB_ACTIONS:-}" != true || "${RUNNER_ENVIRONMENT:-}" != github-hosted || "${RUNNER_OS:-}" != Linux ]]; then
  echo 'Run this test only in a disposable GitHub-hosted Linux VM.' >&2
  exit 1
fi
for account in ansibleinitial ansibletest; do
  if getent passwd "$account" > /dev/null; then
    echo 'The VM test requires fresh fixture accounts.' >&2
    exit 1
  fi
done
export PATH="$PWD/.venv/bin:$PATH"
export PROJECTS_DIR=work-projects
vm_dir="$(mktemp -d "$RUNNER_TEMP/ansible-vm.XXXXXX")"
trap 'rm -rf -- "$vm_dir"' EXIT

sudo apt-get update -qq
sudo apt-get install -y --no-install-recommends openssh-server sudo acl strace
sudo useradd -m -s /bin/bash ansibleinitial
printf '%s\n' 'ansibleinitial ALL=(ALL:ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/ansibleinitial-test > /dev/null
sudo chmod 0440 /etc/sudoers.d/ansibleinitial-test
sudo visudo -cf /etc/sudoers.d/ansibleinitial-test
ssh-keygen -q -t ed25519 -N '' -f "$vm_dir/id"
sudo install -d -o ansibleinitial -g ansibleinitial -m 0700 /home/ansibleinitial/.ssh
sudo install -o ansibleinitial -g ansibleinitial -m 0600 "$vm_dir/id.pub" /home/ansibleinitial/.ssh/authorized_keys
printf '%s\n' 'Port 2222' | sudo tee /etc/ssh/sshd_config.d/99-test-port.conf > /dev/null
sudo systemctl disable --now ssh.socket
sudo systemctl restart ssh.service
python3 tests/vm-inventory.py "$vm_dir"
ansible-playbook -i "$vm_dir/inventory.json" bootstrap.yml

# Hosted workspaces may have private parent directories. Grant the fixture
# account traversal and read access to the test inputs and Python environment.
fixture_parent="$PWD"
while [[ "$fixture_parent" != / ]]; do
  sudo setfacl -m u:ansibletest:--x "$fixture_parent"
  fixture_parent="$(dirname "$fixture_parent")"
done
sudo setfacl -R -m u:ansibletest:rX roles tests .venv .ansible
sudo setfacl -m u:ansibletest:r ansible.cfg

if [[ -n "${TOOL_INSTALLER_CACHE:-}" && -d "$TOOL_INSTALLER_CACHE" ]]; then
  sudo install -d -o ansibletest -g ansibletest -m 0700 /home/ansibletest/.cache/ansible-installers
  sudo cp -a "$TOOL_INSTALLER_CACHE/." /home/ansibletest/.cache/ansible-installers/
  sudo chown -R ansibletest:ansibletest /home/ansibletest/.cache
fi
run_tool_test() {
  sudo -u ansibletest env "PATH=$PATH" HOME=/home/ansibletest PROJECTS_DIR=work-projects \
    ANSIBLE_LOCAL_TEMP=/home/ansibletest/.cache/ansible-local python3 "$@"
}
run_tool_test tests/projects.py -v
run_tool_test tests/prepare-tools.py
# Synthetic credential only: PR jobs never receive deployment secrets.
export DOPPLER_TOKEN=ansible-fixture-one
ansible-playbook -i "$vm_dir/inventory.json" site.yml
sudo env "PATH=$PATH" python3 tests/doppler-runtime.py
run_tool_test tests/java-shell.py --prepare
run_tool_test tests/toolchain-shell.py --prepare
run_tool_test tests/herdr.py --prepare
# Moshi's picker probes a noninteractive shell over SSH, without sourcing profiles.
ssh -i "$vm_dir/id" -p 2222 -o BatchMode=yes -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$vm_dir/known_hosts" \
  ansibletest@127.0.0.1 'command -v herdr && herdr --version && moshi-hook mux ls --json' \
  > "$vm_dir/herdr-ssh.log"
python3 - "$vm_dir/herdr-ssh.log" <<'PY'
import json
from pathlib import Path
import sys
lines = Path(sys.argv[1]).read_text().splitlines()
assert lines[0] == "/home/ansibletest/.local/bin/herdr", lines
assert lines[1].startswith("herdr "), lines
discovery = json.loads(lines[2])["herdr"]
assert discovery["installed"] and any(item["name"] == "ansible-moshi-test" and item["running"]
                                      for item in discovery["sessions"]), discovery
PY
sudo env "PATH=$PATH" python3 tests/vm-state.py | tee "$vm_dir/state-before.json" > /dev/null
ansible-playbook -i "$vm_dir/inventory.json" site.yml > "$vm_dir/second-run.log"
cat "$vm_dir/second-run.log"
python3 - "$vm_dir/second-run.log" <<'PY'
from pathlib import Path
import re
import sys
output = Path(sys.argv[1]).read_text()
assert re.search(r"vm\s+:.*changed=0\s+unreachable=0\s+failed=0", output), "Full host configuration did not converge"
PY
run_tool_test tests/java-shell.py
run_tool_test tests/toolchain-shell.py
run_tool_test tests/herdr.py
run_tool_test tests/herdr.py --cleanup
sudo env "PATH=$PATH" python3 tests/vm-state.py | tee "$vm_dir/state-after.json" > /dev/null
if ! diff -u "$vm_dir/state-before.json" "$vm_dir/state-after.json"; then
  sudo journalctl -u doppler-secrets.service -u apt-daily.service -u apt-daily-upgrade.service --lines=60 --no-pager
  exit 1
fi

# Restart without the controller token, then rotate it through the production role.
env -u DOPPLER_TOKEN sudo systemctl restart doppler-secrets.service
sudo env "PATH=$PATH" python3 tests/doppler-runtime.py
export DOPPLER_TOKEN=ansible-fixture-two
ansible-playbook -i "$vm_dir/inventory.json" tests/doppler.yml
sudo env "PATH=$PATH" python3 tests/doppler-runtime.py --rotated
unset DOPPLER_TOKEN

if [[ -n "${TOOL_INSTALLER_CACHE:-}" ]]; then
  mkdir -p "$TOOL_INSTALLER_CACHE"
  sudo cp -a /home/ansibletest/.cache/ansible-installers/. "$TOOL_INSTALLER_CACHE/"
  sudo chown -R "$(id -u):$(id -g)" "$TOOL_INSTALLER_CACHE"
fi
echo 'Full VM bootstrap, tools, SSH, firewall, timers, and unchanged service state passed'
