#!/usr/bin/env bash
# Inputs are environment variables so workflow expressions never become shell code.
set -euo pipefail
set +x
cd "$(dirname "$0")/.."

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "${DEPLOY_PLAYBOOK:-}" in
  access|bootstrap|site) ;;
  *) fail 'Select access, bootstrap, or site.' ;;
esac
[[ "${DEPLOY_HOST:-}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || fail 'Select one exact inventory hostname.'
[[ -n "${DEPLOY_INVENTORY:-}" ]] || fail 'Supply DEPLOY_INVENTORY through the deployment adapter.'
[[ -n "${DEPLOY_KNOWN_HOSTS:-}" ]] || fail 'Set the verified ANSIBLE_KNOWN_HOSTS environment variable in GitHub.'

# Keep the initial administrator's sudo credential separate from dev's.
if [[ "$DEPLOY_PLAYBOOK" == bootstrap ]]; then
  export ANSIBLE_BECOME_PASS="${DEPLOY_BOOTSTRAP_BECOME_PASSWORD:-${DEPLOY_BOOTSTRAP_PASSWORD:-}}"
else
  unset DEPLOY_BOOTSTRAP_PASSWORD SUDO_PASSWORD_HASH
fi
unset DEPLOY_BOOTSTRAP_BECOME_PASSWORD
if [[ -z "${DEPLOY_BOOTSTRAP_PASSWORD:-}" && -z "${DEPLOY_SSH_PRIVATE_KEY:-}" ]]; then
  fail 'Supply a deployment SSH key, or a password for initial bootstrap.'
fi

umask 077
deployment_dir="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/ansible-deployment.XXXXXX")"
trap 'rm -rf -- "$deployment_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf '%s\n' "$DEPLOY_INVENTORY" > "$deployment_dir/inventory.yml"
printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > "$deployment_dir/known_hosts"
unset DEPLOY_INVENTORY DEPLOY_KNOWN_HOSTS

ssh-keygen -l -f "$deployment_dir/known_hosts" > /dev/null 2>&1 \
  || fail 'ANSIBLE_KNOWN_HOSTS must contain verified OpenSSH known_hosts entries.'

export ANSIBLE_HOST_KEY_CHECKING=True
export ANSIBLE_NOCOLOR=True
export ANSIBLE_RETRY_FILES_ENABLED=False

# A previous connection must not bypass this stage's credentials or host keys.
mkdir "$deployment_dir/control"
export ANSIBLE_SSH_CONTROL_PATH_DIR="$deployment_dir/control"

ssh_options="-o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
ssh_options+=" -o UserKnownHostsFile=\"$deployment_dir/known_hosts\""
ssh_options+=" -o GlobalKnownHostsFile=/dev/null -o KbdInteractiveAuthentication=no"
if [[ -n "${DEPLOY_BOOTSTRAP_PASSWORD:-}" ]]; then
  printf '%s' "$DEPLOY_BOOTSTRAP_PASSWORD" > "$deployment_dir/password"
  authentication=(--connection-password-file "$deployment_dir/password")
  export ANSIBLE_SSH_PASSWORD_MECHANISM=ssh_askpass
  ssh_options+=" -o BatchMode=no -o PreferredAuthentications=password -o PasswordAuthentication=yes -o PubkeyAuthentication=no"
else
  printf '%s\n' "$DEPLOY_SSH_PRIVATE_KEY" > "$deployment_dir/id"
  ssh-keygen -y -P '' -f "$deployment_dir/id" > /dev/null 2>&1 \
    || fail 'The deployment SSH key is invalid or encrypted; provide a dedicated automation key.'
  authentication=(--private-key "$deployment_dir/id")
  ssh_options+=" -o BatchMode=yes -o PreferredAuthentications=publickey -o PasswordAuthentication=no"
fi
unset DEPLOY_BOOTSTRAP_PASSWORD DEPLOY_SSH_PRIVATE_KEY

command=(ansible-playbook -i "$deployment_dir/inventory.yml" "$DEPLOY_PLAYBOOK.yml"
  --limit "$DEPLOY_HOST" "${authentication[@]}" --ssh-common-args "$ssh_options")

"${command[@]}" --syntax-check
"${command[@]}" --list-hosts > "$deployment_dir/hosts.txt"
awk -v target="$DEPLOY_HOST" '
  /^[[:space:]]+hosts \(/ {
    if ($0 ~ /hosts \(1\):[[:space:]]*$/) valid++; else invalid++
  }
  {
    line = $0
    sub(/^[[:space:]]+/, "", line)
    sub(/[[:space:]]+$/, "", line)
    if (line == target) matched++
  }
  END { exit !(valid == 1 && matched == 1 && invalid == 0) }
' "$deployment_dir/hosts.txt" || fail 'The selected playbook must resolve to exactly the requested inventory host.'

"${command[@]}"
