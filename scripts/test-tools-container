#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
engine="${CONTAINER_ENGINE:-podman}"
image="localhost/ansible-playbooks-test:local"
"$engine" build -f tests/Containerfile -t "$image" .
"$engine" run --rm --cap-add=SYS_PTRACE \
  -v "$PWD/roles:/work/roles:ro" \
  -v "$PWD/tests:/work/tests:ro" \
  -v "$PWD/ansible.cfg:/work/ansible.cfg:ro" \
  -e ANSIBLE_COLLECTIONS_PATH=/opt/collections \
  -e ANSIBLE_LOCAL_TEMP=/tmp/ansible-local \
  -e PROJECTS_DIR=work-projects \
  "$image" bash -euo pipefail -c '
    groupadd ansibletest
    useradd -m -g ansibletest -s /bin/bash ansibletest
    ansible-playbook -i localhost, tests/tokeneconomizer.yml --check
    test ! -e /home/ansibletest/.tokeneconomizer
    test ! -e /home/ansibletest/.local/share/tokeneconomizer-source
    runuser -u ansibletest -- python3 tests/projects.py -v
    runuser -u ansibletest -- python3 tests/prepare-tools.py
    ansible-playbook -i localhost, tests/tools.yml
    runuser -u ansibletest -- python3 tests/java-shell.py --prepare
    runuser -u ansibletest -- python3 tests/toolchain-shell.py --prepare
    runuser -u ansibletest -- python3 tests/herdr.py --prepare
    ansible-playbook -i localhost, tests/tools.yml > /tmp/second-run.log
    cat /tmp/second-run.log
    python3 -c '\''import re; from pathlib import Path; s=Path("/tmp/second-run.log").read_text(); assert re.search(r"localhost\s+:.*changed=0\s+unreachable=0\s+failed=0", s), "Tool installation did not converge"'\''
    runuser -u ansibletest -- python3 tests/java-shell.py
    runuser -u ansibletest -- python3 tests/toolchain-shell.py
    runuser -u ansibletest -- python3 tests/tokeneconomizer.py
    runuser -u ansibletest -- python3 tests/herdr.py
    runuser -u ansibletest -- python3 tests/herdr.py --cleanup
    python3 tests/project-workspaces.py
  '
