[Unit]
Description=Doppler secrets for the development account
Requires=doppler-secrets.socket
After=doppler-secrets.socket network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=doppler-secrets
Group=doppler-secrets
ExecStart=/usr/bin/python3 -I /usr/local/lib/doppler-secrets/broker.py --client-user {{ doppler_secrets_client_user }}
LoadCredentialEncrypted=doppler_token:/etc/credstore.encrypted/doppler-secrets/doppler_token
Restart=on-failure
RestartSec=15
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
