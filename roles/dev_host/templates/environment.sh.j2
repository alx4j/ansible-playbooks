# Managed by Ansible. Keep Java and user binaries available without duplicates.
export JAVA_HOME={{ dev_host_java_home | quote }}
export SDKMAN_DIR={{ (dev_host_home ~ '/.sdkman') | quote }}
case ":$PATH:" in
  *":$JAVA_HOME/bin:"*) ;;
  *) export PATH="$JAVA_HOME/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
if [ -n "${BASH_VERSION:-}" ] && [ -z "${dev_host_sdkman_loaded:-}" ] && [ -r "$SDKMAN_DIR/bin/sdkman-init.sh" ]; then
  . "$SDKMAN_DIR/bin/sdkman-init.sh"
  dev_host_sdkman_loaded=1
fi
