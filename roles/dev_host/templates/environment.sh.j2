# Managed by Ansible. SDKMAN installs SDKs; jenv selects Java.
export SDKMAN_DIR={{ (dev_host_home ~ '/.sdkman') | quote }}
export JENV_ROOT={{ (dev_host_home ~ '/.jenv') | quote }}
export GOPATH={{ (dev_host_home ~ '/go') | quote }}
export GOTOOLCHAIN=local
export CARGO_HOME={{ (dev_host_home ~ '/.cargo') | quote }}
export RUSTUP_HOME={{ (dev_host_home ~ '/.rustup') | quote }}
export PROJECTS_DIR={{ (dev_host_home ~ '/' ~ dev_host_projects_dir) | quote }}
for dev_host_bin in "$HOME/.local/bin" "$GOPATH/bin" "$HOME/.local/share/go/current/bin" "$CARGO_HOME/bin" "$SDKMAN_DIR/candidates/gradle/current/bin"; do
  case ":$PATH:" in
    *":$dev_host_bin:"*) ;;
    *) export PATH="$dev_host_bin:$PATH" ;;
  esac
done
unset dev_host_bin
if [ -n "${BASH_VERSION:-}" ] && [ -z "${dev_host_sdkman_loaded:-}" ] && [ -r "$SDKMAN_DIR/bin/sdkman-init.sh" ]; then
  . "$SDKMAN_DIR/bin/sdkman-init.sh"
  dev_host_sdkman_loaded=1
fi
case ":$PATH:" in
  *":$JENV_ROOT/bin:"*) ;;
  *) export PATH="$JENV_ROOT/bin:$PATH" ;;
esac
# Initialize after SDKMAN so Java commands and JAVA_HOME follow jenv.
if [ -n "${BASH_VERSION:-}" ] && [ -z "${dev_host_jenv_loaded:-}" ] && [ -x "$JENV_ROOT/bin/jenv" ]; then
  eval "$("$JENV_ROOT/bin/jenv" init - --no-rehash bash)"
  dev_host_jenv_loaded=1
fi
# Keep Moshi hooks associated with the terminal that launched Codex.
case "$-" in
  *i*) alias codex='codex --no-daemon' ;;
esac
